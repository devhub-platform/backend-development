{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "aerni/cloudflared": "^1.1",
        "agencetwogether/filament-alert-box": "^1.0",
        "algolia/algoliasearch-client-php": "^4.35",
        "alizharb/filament-activity-log": "^1.3",
        "api-platform/laravel": "^4.2",
        "aws/aws-sdk-php": "^3.382",
        "awssat/laravel-visits": "^6.2",
        "azure-oss/storage-blob-laravel": "^1.7",
        "benriadh1/filament-notification-bell": "^1.0",
        "berkayk/onesignal-laravel": "^2.4",
        "binafy/laravel-reactions": "^1.0",
        "cloudinary-labs/cloudinary-laravel": "^3.0",
        "dusterio/laravel-aws-worker": "^1.0",
        "filament/filament": "5.0",
        "guzzlehttp/guzzle": "^7.10",
        "kholil/nitik": "^1.1",
        "laravel/ai": "^0.5.1",
        "laravel/framework": "^12.0",
        "laravel/nightwatch": "^1.24",
        "laravel/passkeys": "^0.2.1",
        "laravel/pulse": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "*",
        "laravel/socialite": "^5.23",
        "laravel/telescope": "*",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.31",
        "maatwebsite/excel": "^3.1",
        "megoxv/laravel-magika": "^1.0",
        "microsoft/azure-storage-blob": "^1.5",
        "mkwebdesign/filament-watchdog-v5": "^1.0",
        "musonza/chat": "*",
        "opcodesio/log-viewer": "^3.21",
        "phpoffice/phpword": "^1.4",
        "predis/predis": "^3.4",
        "pusher/pusher-php-server": "*",
        "qalainau/filament-team-chat": "^0.4.3",
        "rarq/filament-quick-notes": "^1.0",
        "resend/resend-laravel": "^1.4",
        "robertboes/filament-passkeys": "^0.1.0",
        "sendgrid/sendgrid": "^8.1",
        "sentry/sentry-laravel": "^4.25",
        "smalot/pdfparser": "^2.12",
        "socialiteproviders/medium": "^4.1",
        "socialiteproviders/microsoft": "^4.7",
        "spatie/laravel-flare": "^2.8",
        "spatie/laravel-permission": "*",
        "stechstudio/filament-phpinfo": "^1.2",
        "stechstudio/phpinfo": "^1.1",
        "storviaio/vantage": "^0.1.25",
        "tymon/jwt-auth": "^2.2",
        "zpm-packages/server-access-filament": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/league/flysystem-aws-s3-v3/*",
            "vendor/league/flysystem-local/*"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
